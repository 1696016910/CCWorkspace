{
  "name": "claude-workbench",
  "version": "0.2.1",
  "description": "Claude Code CLI 的会话与配置管理外壳",
  "author": "JianZhou",
  "repository": {
    "type": "git",
    "url": "https://github.com/1696016910/CCWorkspace.git"
  },
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "vue-tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "dist": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "check:lock": "node scripts/check-build-lock.mjs",
    "dist:safe": "npm run check:lock && npm run build && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.309",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.1"
  }
}
